<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8.0+). The OS applies the device's own mask
  (circle, squircle, rounded square) to these layers, so the artwork must stay
  inside the 66% safe zone — ic_launcher_foreground.png is generated with that
  inset by tool/generate_icons.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
