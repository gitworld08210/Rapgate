# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Comma-separated allowlist of emails permitted to hold the `admin` claim.
# This is READ ONLY BY CLOUD FUNCTIONS — it is never shipped to the app.
# Passwords are NEVER stored here; they live in Firebase Auth only.
ADMIN_EMAILS=you@example.com

# Vision model for food scanning. Set the key as a Firebase secret:
#   firebase functions:secrets:set VISION_API_KEY
# Get your Gemini API key from: https://aistudio.google.com/apikey
VISION_API_PROVIDER=gemini
VISION_MODEL=gemini-2.0-flash

# Fine amount in paise (5000 = ₹50)
FINE_AMOUNT_PAISE=5000
