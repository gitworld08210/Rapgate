# Supabase project values (never commit the real .env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only authorization and jobs
ADMIN_EMAILS=admin@example.com
CRON_SECRET=replace-with-a-long-random-value
FINE_AMOUNT_PAISE=5000

# Food image analysis (vision).
# Provider: "azure_openai" (default, recommended), "gemini", or "openrouter".
VISION_API_PROVIDER=azure_openai

# --- Azure OpenAI (used when VISION_API_PROVIDER=azure_openai) ---
# Deploy a vision-capable model (gpt-4o / gpt-4o-mini) in Azure OpenAI Studio.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Optional: override the deployment name used for both scan + identify.
# VISION_MODEL=gpt-4o

# --- Gemini / OpenRouter (only if VISION_API_PROVIDER is gemini/openrouter) ---
# VISION_API_KEY=replace-with-gemini-or-openrouter-key
# VISION_MODEL=gemini-2.0-flash

# Optional push delivery adapter. The function records notification_events
# even when this is absent. The endpoint receives {tokens,eventType,payload}.
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=


# ---------------------------------------------------------------------------
# Azure Communication Services (ACS) Email — delivers OTP codes and the
# weekly/monthly report emails. Set EITHER the connection string OR the
# endpoint+key pair, plus a verified sender address.
# ---------------------------------------------------------------------------
AZURE_ACS_CONNECTION_STRING=endpoint=https://YOUR_RESOURCE.communication.azure.com/;accesskey=YOUR_BASE64_ACCESS_KEY
# Alternatively (instead of the connection string):
# AZURE_ACS_ENDPOINT=https://YOUR_RESOURCE.communication.azure.com
# AZURE_ACS_ACCESS_KEY=YOUR_BASE64_ACCESS_KEY

# Verified MailFrom address on your ACS Email domain.
AZURE_ACS_SENDER=DoNotReply@YOUR_VERIFIED_DOMAIN.azurecomm.net
