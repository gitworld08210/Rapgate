# Supabase project values (never commit the real .env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only authorization and jobs
ADMIN_EMAILS=admin@example.com
CRON_SECRET=replace-with-a-long-random-value
FINE_AMOUNT_PAISE=5000

# Food image analysis
VISION_API_PROVIDER=gemini
VISION_API_KEY=replace-with-gemini-or-openrouter-key
VISION_MODEL=gemini-2.0-flash

# Optional push delivery adapter. The function records notification_events
# even when this is absent. The endpoint receives {tokens,eventType,payload}.
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
